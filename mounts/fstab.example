# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=1CFD-53DC                            /boot          vfat    defaults,umask=0077 0 2
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /              btrfs   subvol=/@,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /home          btrfs   subvol=/@home,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /root          btrfs   subvol=/@root,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /srv           btrfs   subvol=/@srv,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /var/cache     btrfs   subvol=/@cache,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /var/tmp       btrfs   subvol=/@tmp,defaults,noatime,compress=zstd:1 0 0
UUID=8a1f0da0-b302-4cbd-bb9c-1a6376178918 /var/log       btrfs   subvol=/@log,defaults,noatime,compress=zstd:1 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0
UUID=7a786a14-d3c5-4479-aba4-6aac645cc0bd /mnt/GAMEFAST btrfs defaults,noatime,compress=zstd:1,nofail,x-systemd.device-timeout=5s,x-gvfs-show,x-gvfs-name=GAMEFAST 0 0
